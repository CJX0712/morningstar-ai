# ===== 晨星 AI · 环境变量示例 =====
# 复制本文件为 .env 并填入你的 Key（只填要用的提供方即可）。

# 默认提供方：openai / deepseek / zhipu / qwen / ollama
DEFAULT_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 智谱 GLM
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-flash

# 通义千问
QWEN_API_KEY=
QWEN_MODEL=qwen-plus

# 本地 Ollama（需先运行 `ollama serve`，无需 Key）
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# 可选：SerpAPI 增强联网搜索（留空则使用 DuckDuckGo）
SERPAPI_KEY=

# 服务端口
PORT=8000
